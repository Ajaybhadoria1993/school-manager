# Where the browser sends API calls. Leave it as /api/v1 in development: the Vite dev server forwards /api to the
# backend on localhost:5000 (change the target with VITE_DEV_API_TARGET if the backend runs elsewhere).
# In production set the full URL of the API, for example https://api.your-school-app.in/api/v1
VITE_API_BASE_URL=/api/v1

# Only for the dev server and `vite preview`: the backend the /api proxy points at.
# VITE_DEV_API_TARGET=http://localhost:5000

# The live map's tiles (Transport > Live tracking). The default is OpenStreetMap's own server, which is for light use only
# (https://operations.osmfoundation.org/policies/tiles/). For a real school, take a free key from a tile host (MapTiler, Stadia Maps...)
# and put its URL here, with {z}/{x}/{y} in it, and its credit line in VITE_MAP_ATTRIBUTION.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
