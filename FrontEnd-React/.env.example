# Where the browser sends API calls. Leave it as /api/v1 in development: the Vite dev server forwards /api to the
# backend on localhost:5000 (change the target with VITE_DEV_API_TARGET if the backend runs elsewhere).
# In production set the full URL of the API, for example https://api.your-school-app.in/api/v1
VITE_API_BASE_URL=/api/v1

# Only for the dev server and `vite preview`: the backend the /api proxy points at.
# VITE_DEV_API_TARGET=http://localhost:5000
