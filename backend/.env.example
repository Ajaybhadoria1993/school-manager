# ---- Server ----
PORT=5000
# development on your machine, production on the server. Unset counts as production (fails without real secrets).
NODE_ENV=development
APP_NAME=EduShiksha
# Public URL of the web app (links in emails point here: sign-up, invitation, password reset, sign-in). The React app runs on 5173 in
# development. Comma-separate more origins for CORS; the FIRST one is the one the emails use.
CLIENT_URL=http://localhost:5173

# ---- Database: local MongoDB (docker compose up -d, from the repo root) ----
MONGODB_URI=mongodb://127.0.0.1:27017/school_erp
# Only if a mongodb+srv:// URI fails with "querySrv ECONNREFUSED" on your machine (some Windows DNS setups):
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Auth: generate each with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" ----
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d
# Seconds an already-used refresh token may be sent again (second tab, retry) without ending the session.
REFRESH_REUSE_GRACE_SECONDS=20
PASSWORD_RESET_TTL_MINUTES=15
INVITE_TOKEN_TTL_HOURS=72
SIGNUP_TOKEN_TTL_HOURS=24

# ---- Super admin (created by: npm run seed:superadmin) ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---- Email (Gmail): use an App Password, not your normal password ----
# https://myaccount.google.com/apppasswords  (2-Step Verification must be on)
# Leave SMTP_PASS empty to only log emails to the console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduShiksha <you@gmail.com>"

# ---- Email (Brevo API): for hosts that block SMTP ports, e.g. Render's free instances ----
# When set, emails go through Brevo instead of SMTP. SMTP_FROM above must then be a sender verified in Brevo
# (Brevo > Settings > Senders, domains & dedicated IPs). Key: Brevo > Settings > SMTP & API > API keys.
BREVO_API_KEY=
